---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>Schedule | Garden City Worship Scheduler</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={`${base}/`}><img src="https://static1.squarespace.com/static/620f0941d330e41f0b6d693f/t/6254fe163007293d1ab2d660/1649737238964/GC+PEDALS+ICON+%28BLACK%29.png?format=300w" alt="" /><span class="brand-copy"><strong>Garden City Church</strong><small>Worship Scheduler</small></span></a>
			<nav><a href={`${base}/people/`}>People</a><a href={`${base}/bands/`}>Weekly bands</a><a aria-current="page" href={`${base}/schedule/`}>Schedule</a></nav>
		</header>
		<main class="people-page">
			<section class="page-heading">
				<div><p class="eyebrow">Schedule builder</p><h1>Suggestions</h1><p class="lede">Build a balanced rotation, review it, then add unconfirmed placeholders to existing Planning Center plans.</p></div>
			</section>
			<details class="suggestion-rules" open>
				<summary>How band suggestions are built</summary>
				<div class="rules-grid">
					<section>
						<p class="rule-kind">Required</p>
						<h2>Eligibility &amp; availability</h2>
						<ul>
							<li>The musician must be marked active and have a Band tier.</li>
							<li>They must be assigned to the instrument position in Planning Center.</li>
							<li>Planning Center blockout occurrences make them unavailable, including recurring blockouts and recurrence exceptions.</li>
							<li>Musicians linked by a “schedule together” rule are placed together or not at all.</li>
						</ul>
					</section>
					<section>
						<p class="rule-kind">Balanced when possible</p>
						<h2>Rotation &amp; band mix</h2>
						<ul>
							<li>Existing Planning Center assignments fill their matching positions first and count toward the week’s balance.</li>
							<li>Prior confirmed and unconfirmed Planning Center assignments—including placeholders—are included in the lookback.</li>
							<li>People with fewer assignments in this suggested range are favored.</li>
							<li>No musician exceeds the configured monthly maximum; people marked Every Sunday are exempt.</li>
							<li>Normal-rotation musicians are not suggested on consecutive Sundays.</li>
							<li>Planning Center cadence preferences are minimum spacing rules: every other week is 14 days, monthly is 28 days, and “every 6 weeks” is 42 days.</li>
							<li>The scheduler favors the tier used least in that week to spread A, B, and C musicians equitably.</li>
							<li>A musician marked “Every Sunday” is placed in Worship Leader first whenever they are not blocked out.</li>
							<li>A musician assigned to Worship Leader and a secondary instrument can fill both positions that Sunday, while counting as one person in the rotation.</li>
							<li>For an Every Sunday worship leader, the least-used eligible secondary instrument is favored to rotate roles such as keys and electric guitar.</li>
							<li>Weekly instrument minimums are filled from the default lineup plus any Sunday overrides.</li>
						</ul>
					</section>
				</div>
				<p class="rules-note">Availability, position matching, required pairs, and Planning Center cadence are hard rules. Assignment frequency and tier balance guide the best available choice.</p>
			</details>
			<section class="toolbar schedule-toolbar" aria-label="Schedule range">
				<label>From Sunday<select id="starts-on" disabled><option>Loading Sunday plans…</option></select></label>
				<label>Through Sunday<select id="ends-on" disabled><option>Loading Sunday plans…</option></select></label>
				<label>Monthly maximum<input id="monthly-cap" type="number" min="1" max="5" value="2" aria-describedby="monthly-cap-help" /><small id="monthly-cap-help">Every Sunday musicians are exempt.</small></label>
				<button id="generate" type="button" disabled>Suggest bands</button>
			</section>
			<p id="schedule-message" class="notice" role="status">Choose a range containing configured weekly bands.</p>
			<section id="schedule-results" class="schedule-results" hidden></section>
			<div id="publish-bar" class="publish-bar" hidden>
				<div><strong>Ready when you are</strong><span>People are added as unconfirmed placeholders. No invitations or notifications are prepared or sent.</span></div>
				<button id="publish" type="button">Add placeholders to Planning Center</button>
			</div>
		</main>

		<script>
			import { getSupabase, supabaseConfigured } from '../lib/supabase';
			import { preferenceGap, suggestWeeks, type Candidate, type Slot, type WeekSuggestion } from '../lib/scheduler/generate';
			import { requiredGroupFor } from '../lib/scheduler/eligibility';
			type Resource = { id: string; attributes: Record<string, any>; relationships?: Record<string, { data?: { id?: string } }> };
			type Requirement = { service_date: string; planning_center_team_id: string; planning_center_team_position_id: string; position_name: string; required_count: number };
			type DefaultRequirement = Omit<Requirement, 'service_date'>;
			type Setting = { planning_center_person_id: string; active: boolean; skill_level: 'A' | 'B' | 'C' | null; schedule_every_sunday: boolean };
			type Pair = { person_one_id: string; person_two_id: string };
			type DraftRow = { id: string; planning_center_plan_id: string; planning_center_person_id: string; planning_center_team_id: string; position_name: string; person_name: string; planning_center_plan_person_id: string | null; published_at: string | null };
			type ExistingPlanAssignment = { personId: string; personName: string; positionName: string; status: string; fillsRequirement: boolean; positionId?: string };
			type RenderedWeek = WeekSuggestion & { teamId: string; teamName: string; planId?: string; planUrl?: string; existing: ExistingPlanAssignment[] };

			const startsOn = document.querySelector<HTMLSelectElement>('#starts-on')!;
			const endsOn = document.querySelector<HTMLSelectElement>('#ends-on')!;
			const generateButton = document.querySelector<HTMLButtonElement>('#generate')!;
			const monthlyCapInput = document.querySelector<HTMLInputElement>('#monthly-cap')!;
			const publishButton = document.querySelector<HTMLButtonElement>('#publish')!;
			const message = document.querySelector<HTMLParagraphElement>('#schedule-message')!;
			const results = document.querySelector<HTMLElement>('#schedule-results')!;
			const publishBar = document.querySelector<HTMLElement>('#publish-bar')!;

			if (!supabaseConfigured) message.textContent = 'Supabase is not configured yet.';
			else {
				const supabase = getSupabase();
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) message.textContent = 'Sign in from the home page to build schedules.';
				else {
					let draftId = '';
					let draftRows: DraftRow[] = [];
					let renderedWeeks: RenderedWeek[] = [];
					let teamServiceTypes = new Map<string, string>();
					let candidatesByTeam = new Map<string, Candidate[]>();
					let priorHistoryByTeam = new Map<string, Map<string, string[]>>();
					let activePairs: Pair[] = [];
					let monthlyCap = 2;
					let schedulingConfiguration: Record<string, unknown> = {};
					const savedRules = await supabase.from('scheduling_rules').select('configuration').eq('owner_id', session.user.id).maybeSingle();
					if (!savedRules.error) { schedulingConfiguration = savedRules.data?.configuration ?? {}; const configuredCap = Number(schedulingConfiguration.monthly_maximum); if (Number.isInteger(configuredCap) && configuredCap >= 1 && configuredCap <= 5) monthlyCap = configuredCap; }
					monthlyCapInput.value = String(monthlyCap);
					monthlyCapInput.addEventListener('change', async () => { const next = Math.max(1, Math.min(5, Number(monthlyCapInput.value) || 2)); monthlyCapInput.value = String(next); const configuration = { ...schedulingConfiguration, monthly_maximum: next }; const { error } = await supabase.from('scheduling_rules').upsert({ owner_id: session.user.id, configuration, updated_at: new Date().toISOString() }, { onConflict: 'owner_id' }); if (error) { message.classList.add('error-notice'); message.textContent = error.message; monthlyCapInput.value = String(monthlyCap); return; } monthlyCap = next; schedulingConfiguration = configuration; message.classList.remove('error-notice'); message.textContent = `Monthly maximum saved at ${next} Sunday${next === 1 ? '' : 's'} per musician.`; });
					const savedTeamSettings = await supabase.from('team_settings').select('planning_center_team_id,visible');
					if (savedTeamSettings.error) { message.classList.add('error-notice'); message.textContent = savedTeamSettings.error.message; throw savedTeamSettings.error; }
					const hiddenTeamIds = new Set((savedTeamSettings.data ?? []).filter((item) => !item.visible).map((item) => item.planning_center_team_id));
					const callPco = async (path: string, method = 'GET', body?: Record<string, unknown>) => {
						const { data, error } = await supabase.functions.invoke('planning-center', { body: { method, path, body } });
						if (!error) return data;
						const response = 'context' in error && error.context instanceof Response ? error.context : undefined;
						let detail = error.message;
						if (response) {
							try { const payload = await response.clone().json(); detail = payload.error ?? payload.message ?? payload.errors?.[0]?.detail ?? detail; }
							catch { const text = await response.clone().text(); if (text) detail = text; }
							throw new Error(`Planning Center request failed (${response.status}): ${detail}`);
						}
						throw new Error(`Could not reach the scheduling service: ${detail}`);
					};
					const fetchAll = async <T,>(path: string): Promise<T[]> => {
						const records: T[] = [];
						for (let page = 0; path && page < 20; page++) {
							const payload = await callPco(path); records.push(...(payload.data ?? []));
							path = payload.links?.next ? new URL(payload.links.next).pathname + new URL(payload.links.next).search : '';
						}
						return records;
					};
					const loadPlanDateOptions = async () => {
						try {
							message.textContent = 'Loading upcoming Sunday plans from Planning Center…';
							const serviceTypes = (await fetchAll<Resource>('/services/v2/service_types?per_page=100')).filter((serviceType) => !serviceType.attributes.archived_at && !serviceType.attributes.deleted_at);
							const teamGroups = await Promise.all(serviceTypes.map(async (serviceType) => (await fetchAll<Resource>(`/services/v2/service_types/${encodeURIComponent(serviceType.id)}/teams?per_page=100`)).map((team) => ({ ...team, relationships: { ...team.relationships, service_type: { data: { id: serviceType.id } } } }))));
							const teams = [...new Map(teamGroups.flat().filter((team) => !team.attributes.archived_at && !team.attributes.deleted_at && !hiddenTeamIds.has(team.id)).map((team) => [team.id, team])).values()];
							const serviceTypeIds = [...new Set(teams.map((team) => team.relationships?.service_type?.data?.id).filter((id): id is string => Boolean(id)))];
							const planGroups = await Promise.all(serviceTypeIds.map((id) => fetchAll<Resource>(`/services/v2/service_types/${encodeURIComponent(id)}/plans?filter=future&order=sort_date&per_page=100`)));
							const dates = [...new Set(planGroups.flat().map((plan) => String(plan.attributes.sort_date ?? '').slice(0, 10)).filter((date) => date && new Date(`${date}T12:00:00`).getDay() === 0))].sort();
							const options = dates.map((date) => new Option(new Date(`${date}T12:00:00`).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }), date));
							startsOn.replaceChildren(...options.map((option) => option.cloneNode(true) as HTMLOptionElement)); endsOn.replaceChildren(...options.map((option) => option.cloneNode(true) as HTMLOptionElement));
							startsOn.disabled = !dates.length; endsOn.disabled = !dates.length; generateButton.disabled = !dates.length;
							if (dates.length) { startsOn.value = dates[0]; endsOn.value = dates[Math.min(7, dates.length - 1)]; message.textContent = 'Choose the first and last Sunday to schedule.'; }
							else { startsOn.replaceChildren(new Option('No upcoming Sunday plans', '')); endsOn.replaceChildren(new Option('No upcoming Sunday plans', '')); message.textContent = 'No upcoming Sunday plans were found in Planning Center.'; }
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not load Planning Center plan dates.'; }
					};
					const nameOf = (person: Resource) => person.attributes.name ?? `${person.attributes.first_name ?? ''} ${person.attributes.last_name ?? ''}`.trim();
					const blockedDates = (blocks: Resource[], dates: string[]) => dates.filter((date) => blocks.some((block) => {
						const start = String(block.attributes.starts_at ?? '').slice(0, 10); const end = String(block.attributes.ends_at ?? start).slice(0, 10);
						return start && date >= start && date <= end;
					}));
					const renderSchedule = () => {
						results.replaceChildren();
						for (const week of renderedWeeks) {
							const card = document.createElement('article'); card.className = 'week-card';
							const heading = document.createElement('div'); heading.className = 'week-heading';
							const title = document.createElement('div'); title.innerHTML = `<p>${new Date(`${week.date}T12:00:00`).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })}</p><h2>${week.teamName}</h2>`;
							const plan = document.createElement(week.planUrl ? 'a' : 'span'); plan.textContent = week.planId ? 'Planning Center plan found' : 'No matching plan'; if (week.planUrl) { (plan as HTMLAnchorElement).href = week.planUrl; (plan as HTMLAnchorElement).target = '_blank'; }
							heading.append(title, plan); card.append(heading);
							const list = document.createElement('ul'); list.className = 'assignment-list';
							for (const assignment of week.existing) { const item = document.createElement('li'); item.className = 'existing-assignment'; item.innerHTML = `<span><strong>${assignment.positionName}</strong><span class="person-with-reason">${assignment.personName}<span class="reason-tooltip" tabindex="0" aria-label="Why ${assignment.personName} is here">i<span role="tooltip">Already scheduled in Planning Center with status: ${assignment.status}.</span></span></span></span><span class="existing-chip">Already scheduled · ${assignment.status}</span>`; list.append(item); }
							for (const assignment of week.assignments) {
								const item = document.createElement('li'); const identity = document.createElement('span'); const position = document.createElement('strong'); position.textContent = assignment.positionName; const personLine = document.createElement('span'); personLine.className = 'person-with-reason'; personLine.append(document.createTextNode(assignment.personName));
								const tooltip = document.createElement('span'); tooltip.className = 'reason-tooltip'; tooltip.tabIndex = 0; tooltip.setAttribute('aria-label', `Why ${assignment.personName} was suggested`); tooltip.textContent = 'i'; const tooltipBody = document.createElement('span'); tooltipBody.setAttribute('role', 'tooltip'); const reasons = document.createElement('ul'); for (const reason of assignment.reasons) { const reasonItem = document.createElement('li'); reasonItem.textContent = reason; reasons.append(reasonItem); } tooltipBody.append(reasons); tooltip.append(tooltipBody); personLine.append(tooltip); identity.append(position, personLine);
								const actions = document.createElement('span'); actions.className = 'assignment-actions'; const tier = document.createElement('span'); tier.className = 'tier-chip'; tier.textContent = `Tier ${assignment.tier}`; const swap = document.createElement('button'); swap.type = 'button'; swap.className = 'swap-button'; swap.textContent = 'Swap';
								const hasPairedRule = requiredGroupFor(assignment.personId, activePairs).size > 1 && !week.assignments.some((other) => other !== assignment && other.personId === assignment.personId);
								if (hasPairedRule) { swap.disabled = true; swap.title = 'This musician belongs to a required pair and cannot be swapped individually.'; }
								swap.addEventListener('click', () => {
									const occupied = new Set([...week.existing.map((member) => member.personId), ...week.assignments.filter((other) => other !== assignment && other.personId !== assignment.personId).map((other) => other.personId)]);
									const alternatives = (candidatesByTeam.get(week.teamId) ?? []).filter((candidate) => { const otherDates = [...(priorHistoryByTeam.get(week.teamId)?.get(candidate.id) ?? []), ...renderedWeeks.flatMap((rendered) => [...rendered.existing, ...rendered.assignments].filter((member) => member.personId === candidate.id).map(() => rendered.date))]; const preference = candidate.preferencesByPosition?.[assignment.positionId] ?? ''; const gap = preferenceGap(preference); const respectsCadence = preference.toLowerCase() !== 'unavailable' && (!gap || otherDates.every((otherDate) => Math.abs(Date.parse(week.date) - Date.parse(otherDate)) / 86400000 >= gap)); const avoidsBackToBack = candidate.scheduleEverySunday || otherDates.every((otherDate) => Math.abs(Date.parse(week.date) - Date.parse(otherDate)) / 86400000 >= 14); const monthCount = new Set(otherDates.filter((date) => date.slice(0, 7) === week.date.slice(0, 7))).size; return candidate.id !== assignment.personId && !occupied.has(candidate.id) && !candidate.blockedDates.includes(week.date) && candidate.positionIds.includes(assignment.positionId) && respectsCadence && avoidsBackToBack && (candidate.scheduleEverySunday || monthCount < monthlyCap) && [...requiredGroupFor(candidate.id, activePairs)].every((id) => id === candidate.id || occupied.has(id)); });
									if (!alternatives.length) { message.textContent = `No other eligible, available ${assignment.positionName} musicians can be swapped in without breaking a scheduling rule.`; return; }
									const editor = document.createElement('span'); editor.className = 'swap-editor'; const select = document.createElement('select'); select.setAttribute('aria-label', `Replacement for ${assignment.personName}`); select.append(new Option('Choose replacement', ''), ...alternatives.sort((a, b) => a.name.localeCompare(b.name)).map((candidate) => new Option(`${candidate.name} · Tier ${candidate.skill_level}`, candidate.id))); const cancel = document.createElement('button'); cancel.type = 'button'; cancel.className = 'text-button'; cancel.textContent = 'Cancel'; cancel.addEventListener('click', renderSchedule); select.addEventListener('change', async () => { if (!select.value) return; const replacement = alternatives.find((candidate) => candidate.id === select.value)!; select.disabled = true; cancel.disabled = true; const row = draftRows.find((draft) => draft.planning_center_plan_id === week.planId && draft.planning_center_team_id === week.teamId && draft.planning_center_person_id === assignment.personId && draft.position_name === assignment.positionName && !draft.published_at); if (row) { const { error } = await supabase.from('draft_assignments').update({ planning_center_person_id: replacement.id, person_name: replacement.name, manually_selected: true }).eq('id', row.id); if (error) { message.classList.add('error-notice'); message.textContent = error.message; renderSchedule(); return; } row.planning_center_person_id = replacement.id; row.person_name = replacement.name; } assignment.personId = replacement.id; assignment.personName = replacement.name; assignment.tier = replacement.skill_level!; assignment.reasons = [`Manually swapped in for ${assignment.positionName}`, `Assigned to ${assignment.positionName} in Planning Center`, 'No Planning Center blockout on this date']; message.classList.remove('error-notice'); message.textContent = `${replacement.name} replaced the original ${assignment.positionName} suggestion for ${new Date(`${week.date}T12:00:00`).toLocaleDateString()}.`; renderSchedule(); }); editor.append(select, cancel); actions.replaceChildren(editor);
								});
								actions.append(tier, swap); item.append(identity, actions); list.append(item);
							}
							for (const slot of week.unfilled) { const item = document.createElement('li'); item.className = 'unfilled'; const identity = document.createElement('span'); const position = document.createElement('strong'); position.textContent = slot.positionName; const explanation = document.createElement('span'); explanation.className = 'person-with-reason'; explanation.append(document.createTextNode('No eligible, available musician')); const tooltip = document.createElement('span'); tooltip.className = 'reason-tooltip unfilled-tooltip'; tooltip.tabIndex = 0; tooltip.setAttribute('aria-label', `Why ${slot.positionName} is unfilled`); tooltip.textContent = 'i'; const tooltipBody = document.createElement('span'); tooltipBody.setAttribute('role', 'tooltip'); const reasons = document.createElement('ul'); for (const reason of slot.reasons) { const reasonItem = document.createElement('li'); reasonItem.textContent = reason; reasons.append(reasonItem); } tooltipBody.append(reasons); tooltip.append(tooltipBody); explanation.append(tooltip); identity.append(position, explanation); const status = document.createElement('span'); status.textContent = 'Unfilled'; item.append(identity, status); list.append(item); }
							card.append(list); results.append(card);
						}
						results.hidden = false; publishBar.hidden = !draftRows.length;
					};
					await loadPlanDateOptions();

					generateButton.addEventListener('click', async () => {
						if (!startsOn.value || !endsOn.value || endsOn.value < startsOn.value) { message.textContent = 'Choose a valid date range.'; return; }
						generateButton.disabled = true; publishBar.hidden = true; results.hidden = true; message.classList.remove('error-notice'); message.textContent = 'Reading requirements, availability, and Planning Center plans…';
						try {
							const [requirementsResult, defaultsResult, settingsResult, pairsResult, serviceTypes] = await Promise.all([
								supabase.from('weekly_instrument_requirements').select('service_date,planning_center_team_id,planning_center_team_position_id,position_name,required_count').gte('service_date', startsOn.value).lte('service_date', endsOn.value).order('service_date'),
								supabase.from('default_instrument_requirements').select('planning_center_team_id,planning_center_team_position_id,position_name,required_count'),
								supabase.from('member_settings').select('planning_center_person_id,active,skill_level,schedule_every_sunday'),
								supabase.from('required_pair_rules').select('person_one_id,person_two_id'),
								fetchAll<Resource>('/services/v2/service_types?per_page=100'),
							]);
							if (requirementsResult.error) throw requirementsResult.error; if (defaultsResult.error) throw defaultsResult.error; if (settingsResult.error) throw settingsResult.error; if (pairsResult.error) throw pairsResult.error;
							const activeServiceTypes = serviceTypes.filter((serviceType) => !serviceType.attributes.archived_at && !serviceType.attributes.deleted_at);
							const teamGroups = await Promise.all(activeServiceTypes.map(async (serviceType) => (await fetchAll<Resource>(`/services/v2/service_types/${encodeURIComponent(serviceType.id)}/teams?per_page=100`)).map((team) => ({ ...team, relationships: { ...team.relationships, service_type: { data: { id: serviceType.id } } } }))));
							const activeTeams = [...new Map(teamGroups.flat().filter((team) => !team.attributes.archived_at && !team.attributes.deleted_at && !hiddenTeamIds.has(team.id)).map((team) => [team.id, team])).values()];
							const activeTeamIds = new Set(activeTeams.map((team) => team.id));
							const requirements = ((requirementsResult.data ?? []) as Requirement[]).filter((item) => activeTeamIds.has(item.planning_center_team_id));
							const defaultRequirements = ((defaultsResult.data ?? []) as DefaultRequirement[]).filter((item) => activeTeamIds.has(item.planning_center_team_id));
							if (!requirements.length && !defaultRequirements.length) throw new Error('No instrument requirements are configured. Add the default lineup on Weekly bands first.');
							const settings = new Map(((settingsResult.data ?? []) as Setting[]).map((item) => [item.planning_center_person_id, item]));
							const pairs = (pairsResult.data ?? []) as Pair[]; activePairs = pairs;
							const teamNames = new Map(activeTeams.map((team) => [team.id, String(team.attributes.name ?? `Team ${team.id}`)]));
							teamServiceTypes = new Map(activeTeams.map((team): [string, string] => [team.id, team.relationships?.service_type?.data?.id ?? '']).filter((entry) => entry[1]));
							const teamIds = [...new Set([...requirements, ...defaultRequirements].map((item) => item.planning_center_team_id))]; renderedWeeks = []; const schedulingHistory = new Map<string, string[]>();
							for (const teamId of teamIds) {
								const teamRequirements = requirements.filter((item) => item.planning_center_team_id === teamId);
								const teamDefaults = defaultRequirements.filter((item) => item.planning_center_team_id === teamId);
								const serviceTypeId = teamServiceTypes.get(teamId); if (!serviceTypeId) throw new Error(`Could not identify the Planning Center service type for ${teamNames.get(teamId)}.`);
								const [futurePlans, pastPayload] = await Promise.all([fetchAll<Resource>(`/services/v2/service_types/${serviceTypeId}/plans?filter=future&order=sort_date&per_page=100`), callPco(`/services/v2/service_types/${serviceTypeId}/plans?filter=past&order=-sort_date&per_page=100`)]);
								const plans = [...new Map([...(pastPayload.data ?? []), ...futurePlans].map((plan: Resource) => [plan.id, plan])).values()];
								const plansByDate = new Map(plans.map((plan) => [String(plan.attributes.sort_date ?? '').slice(0, 10), plan]));
								const planDates = [...plansByDate.keys()].filter((date) => date >= startsOn.value && date <= endsOn.value && new Date(`${date}T12:00:00`).getDay() === 0);
								const candidateDates = new Set(teamDefaults.length ? planDates : []); for (const item of teamRequirements) candidateDates.add(item.service_date);
								const slotsByDate = new Map<string, Slot[]>();
								for (const date of candidateDates) { const counts = new Map(teamDefaults.map((item) => [item.planning_center_team_position_id, { name: item.position_name, count: item.required_count }])); for (const item of teamRequirements.filter((entry) => entry.service_date === date)) counts.set(item.planning_center_team_position_id, { name: item.position_name, count: item.required_count }); const slots: Slot[] = []; for (const [positionId, value] of counts) for (let i = 0; i < value.count; i++) slots.push({ positionId, positionName: value.name }); if (slots.length) slotsByDate.set(date, slots); }
								const dates = [...slotsByDate.keys()].sort();
								const existingByDate = new Map<string, ExistingPlanAssignment[]>();
								await Promise.all(dates.map(async (date) => {
									const plan = plansByDate.get(date); if (!plan) { existingByDate.set(date, []); return; }
									const members = await fetchAll<Resource>(`/services/v2/service_types/${serviceTypeId}/plans/${plan.id}/team_members?where[team_id]=${encodeURIComponent(teamId)}&per_page=100`);
									const scheduledMembers = members.filter((member) => !['d', 'declined'].includes(String(member.attributes.status ?? '').toLowerCase()));
									const remaining = [...(slotsByDate.get(date) ?? [])];
									const existing = scheduledMembers.map((member) => {
										const positionName = String(member.attributes.team_position_name ?? 'Team member');
										const slotIndex = remaining.findIndex((slot) => slot.positionName.toLowerCase() === positionName.toLowerCase());
										const matchedSlot = slotIndex >= 0 ? remaining[slotIndex] : undefined; const fillsRequirement = Boolean(matchedSlot); if (fillsRequirement) remaining.splice(slotIndex, 1);
										return { personId: member.relationships?.person?.data?.id ?? '', personName: String(member.attributes.name ?? 'Scheduled musician'), positionName, status: String(member.attributes.status ?? 'Scheduled'), fillsRequirement, positionId: matchedSlot?.positionId };
									}).filter((member) => member.personId);
									existingByDate.set(date, existing); slotsByDate.set(date, remaining);
								}));
								const [people, assignments] = await Promise.all([
									fetchAll<Resource>(`/services/v2/teams/${encodeURIComponent(teamId)}/people?per_page=100`),
									fetchAll<Resource>(`/services/v2/teams/${encodeURIComponent(teamId)}/person_team_position_assignments?per_page=100`),
								]);
								const positionIds = new Map<string, string[]>();
								const preferencesByPerson = new Map<string, Record<string, string>>();
								for (const assignment of assignments) { const personId = assignment.relationships?.person?.data?.id; const positionId = assignment.relationships?.team_position?.data?.id; if (personId && positionId) { positionIds.set(personId, [...(positionIds.get(personId) ?? []), positionId]); const preference = String(assignment.attributes.schedule_preference ?? ''); preferencesByPerson.set(personId, { ...(preferencesByPerson.get(personId) ?? {}), [positionId]: preference }); } }
								for (const [date, existing] of existingByDate) {
									const remaining = slotsByDate.get(date) ?? [];
									for (const leader of [...existing].filter((member) => member.positionName.toLowerCase().includes('worship leader'))) {
										if (existing.some((member) => member !== leader && member.personId === leader.personId)) continue;
										const secondaryIndex = remaining.findIndex((slot) => !slot.positionName.toLowerCase().includes('worship leader') && (positionIds.get(leader.personId) ?? []).includes(slot.positionId));
										if (secondaryIndex < 0) continue;
										const [secondary] = remaining.splice(secondaryIndex, 1); existing.push({ ...leader, positionName: secondary.positionName, positionId: secondary.positionId, fillsRequirement: true });
									}
								}
								const eligiblePeople = people.filter((person) => settings.get(person.id)?.active && settings.get(person.id)?.skill_level);
								const availability = await Promise.all(eligiblePeople.map(async (person) => {
									const blocks = await fetchAll<Resource>(`/services/v2/people/${person.id}/blockouts?filter=future&per_page=100`);
									const occurrences = (await Promise.all(blocks.map((block) => fetchAll<Resource>(`/services/v2/people/${person.id}/blockouts/${block.id}/blockout_dates?per_page=100`)))).flat();
									const setting = settings.get(person.id)!; return { id: person.id, name: nameOf(person), active: setting.active, skill_level: setting.skill_level, positionIds: positionIds.get(person.id) ?? [], blockedDates: blockedDates(occurrences, dates), preferencesByPosition: preferencesByPerson.get(person.id) ?? {}, scheduleEverySunday: setting.schedule_every_sunday } as Candidate;
								}));
								candidatesByTeam.set(teamId, availability);
								const maxPreferenceGap = Math.max(0, ...availability.flatMap((candidate) => Object.values(candidate.preferencesByPosition ?? {}).map(preferenceGap))); const lookbackDays = Math.max(84, maxPreferenceGap);
								const firstDate = dates[0]; const lookbackStart = firstDate ? new Date(Date.parse(`${firstDate}T12:00:00`) - lookbackDays * 86400000).toISOString().slice(0, 10) : '';
								const priorPlans = plans.filter((plan) => { const date = String(plan.attributes.sort_date ?? '').slice(0, 10); return date >= lookbackStart && date < firstDate; });
								const priorHistory = new Map<string, string[]>();
								await Promise.all(priorPlans.map(async (plan) => { const date = String(plan.attributes.sort_date ?? '').slice(0, 10); const members = await fetchAll<Resource>(`/services/v2/service_types/${serviceTypeId}/plans/${plan.id}/team_members?where[team_id]=${encodeURIComponent(teamId)}&per_page=100`); const seen = new Set<string>(); for (const member of members.filter((item) => !['d', 'declined'].includes(String(item.attributes.status ?? '').toLowerCase()))) { const personId = member.relationships?.person?.data?.id; if (!personId || seen.has(personId)) continue; seen.add(personId); priorHistory.set(personId, [...(priorHistory.get(personId) ?? []), date]); } }));
								priorHistoryByTeam.set(teamId, priorHistory);
								for (const [personId, assignedDates] of priorHistory) schedulingHistory.set(personId, [...new Set([...(schedulingHistory.get(personId) ?? []), ...assignedDates])].sort());
								const existingForScheduler = new Map([...existingByDate].map(([date, members]) => [date, members.map((member) => ({ personId: member.personId, tier: settings.get(member.personId)?.skill_level ?? null, positionId: member.positionId }))]));
								const suggestions = suggestWeeks(dates, slotsByDate, availability, pairs, existingForScheduler, schedulingHistory, monthlyCap);
								for (const week of suggestions) { const plan = plansByDate.get(week.date); const rendered = { ...week, teamId, teamName: teamNames.get(teamId) ?? `Team ${teamId}`, planId: plan?.id, planUrl: plan?.attributes.planning_center_url, existing: existingByDate.get(week.date) ?? [] }; renderedWeeks.push(rendered); for (const personId of new Set([...rendered.existing.map((member) => member.personId), ...rendered.assignments.map((member) => member.personId)])) schedulingHistory.set(personId, [...new Set([...(schedulingHistory.get(personId) ?? []), week.date])].sort()); }
							}
							renderedWeeks.sort((a, b) => a.date.localeCompare(b.date));
							const { data: draft, error: draftError } = await supabase.from('schedule_drafts').insert({ owner_id: session.user.id, name: `Band suggestions ${startsOn.value}–${endsOn.value}`, starts_on: startsOn.value, ends_on: endsOn.value }).select('id').single();
							if (draftError) throw draftError; draftId = draft.id;
							const rows = renderedWeeks.flatMap((week) => week.planId ? week.assignments.map((assignment) => ({ owner_id: session.user.id, draft_id: draftId, planning_center_plan_id: week.planId!, planning_center_person_id: assignment.personId, planning_center_team_id: week.teamId, position_name: assignment.positionName, person_name: assignment.personName })) : []);
							if (rows.length) { const { data, error } = await supabase.from('draft_assignments').insert(rows).select('id,planning_center_plan_id,planning_center_person_id,planning_center_team_id,position_name,person_name,planning_center_plan_person_id,published_at'); if (error) throw error; draftRows = data as DraftRow[]; } else draftRows = [];
							renderSchedule(); const unfilled = renderedWeeks.reduce((sum, week) => sum + week.unfilled.length, 0); const missingPlans = renderedWeeks.filter((week) => !week.planId).length;
							const existingCount = renderedWeeks.reduce((sum, week) => sum + week.existing.length, 0);
							message.textContent = `${existingCount} existing Planning Center assignment${existingCount === 1 ? '' : 's'} found. ${draftRows.length} placeholder${draftRows.length === 1 ? '' : 's'} suggested to fill the remaining gaps across ${renderedWeeks.length} weekly band${renderedWeeks.length === 1 ? '' : 's'}.${unfilled ? ` ${unfilled} position${unfilled === 1 ? '' : 's'} could not be filled.` : ''}${missingPlans ? ` ${missingPlans} week${missingPlans === 1 ? '' : 's'} has no matching Planning Center plan.` : ''}`;
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not generate suggestions.'; }
						finally { generateButton.disabled = false; }
					});

					publishButton.addEventListener('click', async () => {
						const pending = draftRows.filter((row) => !row.published_at).sort((a, b) => Number(b.position_name.toLowerCase().includes('worship leader')) - Number(a.position_name.toLowerCase().includes('worship leader'))); if (!pending.length) return;
						publishButton.disabled = true; generateButton.disabled = true; message.classList.remove('error-notice'); message.textContent = `Checking ${pending.length} assignment${pending.length === 1 ? '' : 's'} and adding placeholders…`;
						let added = 0; let existing = 0;
						try {
							for (const row of pending) {
								const publishedRole = draftRows.find((item) => item !== row && item.planning_center_plan_id === row.planning_center_plan_id && item.planning_center_person_id === row.planning_center_person_id && item.planning_center_team_id === row.planning_center_team_id && item.published_at);
								if (publishedRole) { const now = new Date().toISOString(); const { error } = await supabase.from('draft_assignments').update({ planning_center_plan_person_id: publishedRole.planning_center_plan_person_id, published_at: now }).eq('id', row.id); if (error) throw error; row.planning_center_plan_person_id = publishedRole.planning_center_plan_person_id; row.published_at = now; continue; }
								const serviceTypeId = teamServiceTypes.get(row.planning_center_team_id); if (!serviceTypeId) throw new Error('A Planning Center service type is missing. Generate the schedule again.');
								const path = `/services/v2/service_types/${serviceTypeId}/plans/${row.planning_center_plan_id}/team_members`;
								const current = await fetchAll<Resource>(`${path}?where[team_id]=${encodeURIComponent(row.planning_center_team_id)}&per_page=100`);
								const found = current.find((item) => item.relationships?.person?.data?.id === row.planning_center_person_id && item.relationships?.team?.data?.id === row.planning_center_team_id && item.attributes.team_position_name === row.position_name);
								let planPersonId = found?.id;
								if (found) existing++; else {
									const response = await callPco(path, 'POST', { data: { type: 'PlanPerson', attributes: { person_id: row.planning_center_person_id, team_id: row.planning_center_team_id, team_position_name: row.position_name, status: 'Unconfirmed', prepare_notification: false } } });
									planPersonId = response.data?.id; added++;
								}
								const now = new Date().toISOString(); const { error } = await supabase.from('draft_assignments').update({ planning_center_plan_person_id: planPersonId ?? null, published_at: now }).eq('id', row.id); if (error) throw error; row.published_at = now;
							}
							await supabase.from('schedule_drafts').update({ status: 'published', updated_at: new Date().toISOString() }).eq('id', draftId);
							message.textContent = `${added} placeholder${added === 1 ? '' : 's'} added to Planning Center without invitations.${existing ? ` ${existing} existing assignment${existing === 1 ? ' was' : 's were'} left unchanged.` : ''}`; publishButton.textContent = 'Added to Planning Center';
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not add all placeholders.'; publishButton.disabled = false; }
						finally { generateButton.disabled = false; }
					});
				}
			}
		</script>
	</body>
</html>
