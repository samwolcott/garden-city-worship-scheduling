---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>Schedule | Garden City Worship Scheduler</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={`${base}/`}><img src="https://static1.squarespace.com/static/620f0941d330e41f0b6d693f/t/6254fe163007293d1ab2d660/1649737238964/GC+PEDALS+ICON+%28BLACK%29.png?format=300w" alt="" /><span class="brand-copy"><strong>Garden City Church</strong><small>Worship Scheduler</small></span></a>
			<nav><a href={`${base}/people/`}>People</a><a href={`${base}/bands/`}>Weekly bands</a><a aria-current="page" href={`${base}/schedule/`}>Schedule</a></nav>
		</header>
		<main class="people-page">
			<section class="page-heading">
				<div><p class="eyebrow">Schedule builder</p><h1>Suggestions</h1><p class="lede">Build a balanced rotation, review it, then add unconfirmed placeholders to existing Planning Center plans.</p></div>
			</section>
			<details class="suggestion-rules" open>
				<summary>How band suggestions are built</summary>
				<div class="rules-grid">
					<section>
						<p class="rule-kind">Required</p>
						<h2>Eligibility &amp; availability</h2>
						<ul>
							<li>The musician must be marked active and have a Band tier.</li>
							<li>They must be assigned to the instrument position in Planning Center.</li>
							<li>Planning Center blockout occurrences make them unavailable, including recurring blockouts and recurrence exceptions.</li>
							<li>Musicians linked by a “schedule together” rule are placed together or not at all.</li>
						</ul>
					</section>
					<section>
						<p class="rule-kind">Balanced when possible</p>
						<h2>Rotation &amp; band mix</h2>
						<ul>
							<li>Existing Confirmed and Unconfirmed Planning Center assignments fill their matching positions first.</li>
							<li>Declined assignments remain visible, and their positions stay open for replacement suggestions.</li>
							<li>Prior confirmed and unconfirmed Planning Center assignments—including placeholders—are included in the lookback.</li>
							<li>People with fewer assignments in this suggested range are favored.</li>
							<li>Each musician’s private serving frequency is enforced, defaulting to every two weeks and supporting quarterly rotation.</li>
							<li>Planning Center cadence preferences are minimum spacing rules: every other week is 14 days, monthly is 28 days, and “every 6 weeks” is 42 days.</li>
							<li>The scheduler favors the tier used least in that week to spread A, B, and C musicians equitably.</li>
							<li>A musician set to “Every week” is placed in Worship Leader first whenever they are not blocked out.</li>
							<li>A musician assigned to Worship Leader and a secondary instrument can fill both positions that Sunday, while counting as one person in the rotation.</li>
							<li>For an Every week worship leader, the least-used eligible secondary instrument is favored to rotate roles such as keys and electric guitar.</li>
							<li>Weekly instrument minimums are filled from the default lineup plus any Sunday overrides.</li>
						</ul>
					</section>
				</div>
				<p class="rules-note">Availability, position matching, required pairs, and Planning Center cadence are hard rules. Assignment frequency and tier balance guide the best available choice.</p>
			</details>
			<section class="toolbar schedule-toolbar" aria-label="Schedule range">
				<label>From Sunday<select id="starts-on" disabled><option>Loading Sunday plans…</option></select></label>
				<label>Through Sunday<select id="ends-on" disabled><option>Loading Sunday plans…</option></select></label>
				<button id="generate" type="button" disabled>Suggest bands</button>
			</section>
			<p id="schedule-message" class="notice" role="status">Choose a range containing configured weekly bands.</p>
			<section id="schedule-results" class="schedule-results" hidden></section>
			<div id="publish-bar" class="publish-bar" hidden>
				<div><strong>Ready when you are</strong><span>People are added as private, unconfirmed placeholders. Planning Center prepares their requests, but does not send them.</span></div>
				<button id="publish" type="button">Add placeholders to Planning Center</button>
			</div>
		</main>

		<script>
			import { getSupabase, supabaseConfigured } from '../lib/supabase';
			import { preferenceGap, suggestWeeks, type Candidate, type Slot, type WeekSuggestion } from '../lib/scheduler/generate';
			import { requiredGroupFor } from '../lib/scheduler/eligibility';
			type Resource = { id: string; attributes: Record<string, any>; relationships?: Record<string, { data?: { id?: string } }> };
			type Requirement = { service_date: string; planning_center_team_id: string; planning_center_team_position_id: string; position_name: string; required_count: number };
			type DefaultRequirement = Omit<Requirement, 'service_date'>;
			type Setting = { planning_center_person_id: string; active: boolean; skill_level: 'A' | 'B' | 'C' | null; minimum_weeks_between: number };
			type Pair = { person_one_id: string; person_two_id: string };
			type DraftRow = { id: string; planning_center_plan_id: string; planning_center_person_id: string; planning_center_team_id: string; position_name: string; person_name: string; planning_center_plan_person_id: string | null; published_at: string | null };
			type PendingDraftChange = { row: DraftRow; assignment: WeekSuggestion['assignments'][number]; replacement: Candidate };
			type ExistingPlanAssignment = { personId: string; personName: string; planPersonId: string; positionName: string; status: 'Confirmed' | 'Unconfirmed' | 'Declined'; fillsRequirement: boolean; positionId?: string; derivedRole?: boolean };
			type PendingExistingChange = { assignment: ExistingPlanAssignment; replacement: Candidate };
			type AudioVisualAssignment = { personId: string; personName: string; positionName: string; status: ExistingPlanAssignment['status'] };
			type RenderedWeek = WeekSuggestion & { teamId: string; teamName: string; planId?: string; planUrl?: string; existing: ExistingPlanAssignment[]; audioVisual: AudioVisualAssignment[] };

			const startsOn = document.querySelector<HTMLSelectElement>('#starts-on')!;
			const endsOn = document.querySelector<HTMLSelectElement>('#ends-on')!;
			const generateButton = document.querySelector<HTMLButtonElement>('#generate')!;
			const publishButton = document.querySelector<HTMLButtonElement>('#publish')!;
			const message = document.querySelector<HTMLParagraphElement>('#schedule-message')!;
			const results = document.querySelector<HTMLElement>('#schedule-results')!;
			const publishBar = document.querySelector<HTMLElement>('#publish-bar')!;

			if (!supabaseConfigured) message.textContent = 'Supabase is not configured yet.';
			else {
				const supabase = getSupabase();
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) message.textContent = 'Sign in from the home page to build schedules.';
				else {
					let draftId = '';
					let draftRows: DraftRow[] = [];
					let renderedWeeks: RenderedWeek[] = [];
					let teamServiceTypes = new Map<string, string>();
					let candidatesByTeam = new Map<string, Candidate[]>();
					let positionNamesByTeam = new Map<string, Map<string, string>>();
					let priorHistoryByTeam = new Map<string, Map<string, string[]>>();
					let activePairs: Pair[] = [];
					const pendingDraftChanges = new Map<string, PendingDraftChange>();
					const pendingExistingChanges = new Map<string, PendingExistingChange>();
					const existingChangeKey = (assignment: ExistingPlanAssignment) => `${assignment.planPersonId}:${assignment.positionName}`;
					const savedTeamSettings = await supabase.from('team_settings').select('planning_center_team_id,visible');
					if (savedTeamSettings.error) { message.classList.add('error-notice'); message.textContent = savedTeamSettings.error.message; throw savedTeamSettings.error; }
					const hiddenTeamIds = new Set((savedTeamSettings.data ?? []).filter((item) => !item.visible).map((item) => item.planning_center_team_id));
					const pcoReadCache = new Map<string, Promise<any>>(); let pcoQueue: Promise<unknown> = Promise.resolve(); let lastPcoRequestAt = 0;
					const callPco = (path: string, method = 'GET', body?: Record<string, unknown>) => {
						const normalizedMethod = method.toUpperCase(); const cacheKey = `${normalizedMethod}:${path}`; if (normalizedMethod === 'GET' && pcoReadCache.has(cacheKey)) return pcoReadCache.get(cacheKey)!;
						if (normalizedMethod !== 'GET') pcoReadCache.clear();
						const request = async () => {
							for (let attempt = 0; attempt < 3; attempt++) {
								const spacing = Math.max(0, 225 - (Date.now() - lastPcoRequestAt)); if (spacing) await new Promise((resolve) => setTimeout(resolve, spacing)); lastPcoRequestAt = Date.now();
								const { data, error } = await supabase.functions.invoke('planning-center', { body: { method: normalizedMethod, path, body } });
								if (!error) return data;
								const response = 'context' in error && error.context instanceof Response ? error.context : undefined; let detail = error.message;
								if (response) { try { const payload = await response.clone().json(); detail = payload.error ?? payload.message ?? payload.errors?.[0]?.detail ?? detail; } catch { const text = await response.clone().text(); if (text) detail = text; } if (response.status === 429 && attempt < 2) { message.textContent = 'Planning Center is busy. Waiting briefly, then continuing automatically…'; await new Promise((resolve) => setTimeout(resolve, 20500)); continue; } throw new Error(`Planning Center request failed (${response.status}): ${detail}`); }
								throw new Error(`Could not reach the scheduling service: ${detail}`);
							}
						};
						const queued = pcoQueue.then(request, request); pcoQueue = queued.then(() => undefined, () => undefined); if (normalizedMethod === 'GET') { pcoReadCache.set(cacheKey, queued); queued.catch(() => pcoReadCache.delete(cacheKey)); } return queued;
					};
					const fetchAll = async <T,>(path: string): Promise<T[]> => {
						const records: T[] = [];
						for (let page = 0; path && page < 20; page++) {
							const payload = await callPco(path); records.push(...(payload.data ?? []));
							path = payload.links?.next ? new URL(payload.links.next).pathname + new URL(payload.links.next).search : '';
						}
						return records;
					};
					const loadPlanDateOptions = async () => {
						try {
							message.textContent = 'Loading upcoming Sunday plans from Planning Center…';
							const serviceTypes = (await fetchAll<Resource>('/services/v2/service_types?per_page=100')).filter((serviceType) => !serviceType.attributes.archived_at && !serviceType.attributes.deleted_at);
							const teamGroups = await Promise.all(serviceTypes.map(async (serviceType) => (await fetchAll<Resource>(`/services/v2/service_types/${encodeURIComponent(serviceType.id)}/teams?per_page=100`)).map((team) => ({ ...team, relationships: { ...team.relationships, service_type: { data: { id: serviceType.id } } } }))));
							const teams = [...new Map(teamGroups.flat().filter((team) => !team.attributes.archived_at && !team.attributes.deleted_at && !hiddenTeamIds.has(team.id)).map((team) => [team.id, team])).values()];
							const serviceTypeIds = [...new Set(teams.map((team) => team.relationships?.service_type?.data?.id).filter((id): id is string => Boolean(id)))];
							const planGroups = await Promise.all(serviceTypeIds.map((id) => fetchAll<Resource>(`/services/v2/service_types/${encodeURIComponent(id)}/plans?filter=future&order=sort_date&per_page=100`)));
							const dates = [...new Set(planGroups.flat().map((plan) => String(plan.attributes.sort_date ?? '').slice(0, 10)).filter((date) => date && new Date(`${date}T12:00:00`).getDay() === 0))].sort();
							const options = dates.map((date) => new Option(new Date(`${date}T12:00:00`).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }), date));
							startsOn.replaceChildren(...options.map((option) => option.cloneNode(true) as HTMLOptionElement)); endsOn.replaceChildren(...options.map((option) => option.cloneNode(true) as HTMLOptionElement));
							startsOn.disabled = !dates.length; endsOn.disabled = !dates.length; generateButton.disabled = !dates.length;
							if (dates.length) { const today = new Date(); const localToday = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`; startsOn.value = today.getDay() === 0 ? dates.find((date) => date > localToday) ?? dates[0] : dates[0]; endsOn.value = dates.at(-1)!; message.textContent = 'Choose the first and last Sunday to schedule.'; }
							else { startsOn.replaceChildren(new Option('No upcoming Sunday plans', '')); endsOn.replaceChildren(new Option('No upcoming Sunday plans', '')); message.textContent = 'No upcoming Sunday plans were found in Planning Center.'; }
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not load Planning Center plan dates.'; }
					};
					const nameOf = (person: Resource) => person.attributes.name ?? `${person.attributes.first_name ?? ''} ${person.attributes.last_name ?? ''}`.trim();
					const blockoutDetails = (blocks: Resource[], dates: string[]) => {
						const blockoutReasonsByDate: Record<string, string[]> = {};
						for (const date of dates) for (const block of blocks) {
							const start = String(block.attributes.starts_at ?? '').slice(0, 10); const end = String(block.attributes.ends_at ?? start).slice(0, 10);
							if (!start || date < start || date > end) continue;
							const reason = String(block.attributes.reason ?? block.attributes.description ?? '').trim();
							if (reason && !(blockoutReasonsByDate[date] ?? []).includes(reason)) blockoutReasonsByDate[date] = [...(blockoutReasonsByDate[date] ?? []), reason];
							else blockoutReasonsByDate[date] ??= [];
						}
						return { blockedDates: Object.keys(blockoutReasonsByDate), blockoutReasonsByDate };
					};
					const planStatus = (status: unknown): ExistingPlanAssignment['status'] => { const value = String(status ?? '').toLowerCase(); if (value === 'c' || value === 'confirmed') return 'Confirmed'; if (value === 'd' || value === 'declined') return 'Declined'; return 'Unconfirmed'; };
					const publishRows = async (rows: DraftRow[], trigger: HTMLButtonElement) => {
						const pending = rows.filter((row) => !row.published_at).sort((a, b) => Number(b.position_name.toLowerCase().includes('worship leader')) - Number(a.position_name.toLowerCase().includes('worship leader'))); if (!pending.length) return;
						trigger.disabled = true; generateButton.disabled = true; message.classList.remove('error-notice'); message.textContent = `Checking ${pending.length} assignment${pending.length === 1 ? '' : 's'} and adding placeholder${pending.length === 1 ? '' : 's'}…`;
						let added = 0; let existing = 0;
						try {
							for (const row of pending) {
								const publishedRole = draftRows.find((item) => item !== row && item.planning_center_plan_id === row.planning_center_plan_id && item.planning_center_person_id === row.planning_center_person_id && item.planning_center_team_id === row.planning_center_team_id && item.published_at);
								if (publishedRole) { const now = new Date().toISOString(); const { error } = await supabase.from('draft_assignments').update({ planning_center_plan_person_id: publishedRole.planning_center_plan_person_id, published_at: now }).eq('id', row.id); if (error) throw error; row.planning_center_plan_person_id = publishedRole.planning_center_plan_person_id; row.published_at = now; continue; }
								const serviceTypeId = teamServiceTypes.get(row.planning_center_team_id); if (!serviceTypeId) throw new Error('A Planning Center service type is missing. Generate the schedule again.');
								const path = `/services/v2/service_types/${serviceTypeId}/plans/${row.planning_center_plan_id}/team_members`;
								const current = await fetchAll<Resource>(`${path}?where[team_id]=${encodeURIComponent(row.planning_center_team_id)}&per_page=100`);
								const found = current.find((item) => item.relationships?.person?.data?.id === row.planning_center_person_id && item.relationships?.team?.data?.id === row.planning_center_team_id && item.attributes.team_position_name === row.position_name);
								let planPersonId = found?.id;
								if (found) existing++; else { const response = await callPco(path, 'POST', { data: { type: 'PlanPerson', attributes: { person_id: row.planning_center_person_id, team_id: row.planning_center_team_id, team_position_name: row.position_name, status: 'Unconfirmed', prepare_notification: true } } }); planPersonId = response.data?.id; added++; }
								const now = new Date().toISOString(); const { error } = await supabase.from('draft_assignments').update({ planning_center_plan_person_id: planPersonId ?? null, published_at: now }).eq('id', row.id); if (error) throw error; row.planning_center_plan_person_id = planPersonId ?? null; row.published_at = now;
							}
							if (draftRows.every((row) => row.published_at)) await supabase.from('schedule_drafts').update({ status: 'published', updated_at: new Date().toISOString() }).eq('id', draftId);
							message.textContent = `${added} private placeholder${added === 1 ? '' : 's'} added to Planning Center with scheduling requests prepared but not sent.${existing ? ` ${existing} existing assignment${existing === 1 ? ' was' : 's were'} left unchanged.` : ''}`; renderSchedule();
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not add the selected placeholders.'; trigger.disabled = false; }
						finally { generateButton.disabled = false; }
					};
					const saveWeekChanges = async (week: RenderedWeek, trigger: HTMLButtonElement) => {
						const draftChanges = [...pendingDraftChanges.values()].filter(({ row }) => row.planning_center_plan_id === week.planId && row.planning_center_team_id === week.teamId);
						const existingChanges = [...pendingExistingChanges.values()].filter(({ assignment }) => week.existing.includes(assignment));
						const changeCount = draftChanges.length + existingChanges.length; if (!changeCount || !week.planId) return;
						trigger.disabled = true; generateButton.disabled = true; message.classList.remove('error-notice'); message.textContent = `Committing ${changeCount} pending change${changeCount === 1 ? '' : 's'} to this lineup…`;
						try {
							for (const { row, assignment, replacement } of draftChanges) {
								const { error } = await supabase.from('draft_assignments').update({ planning_center_person_id: replacement.id, person_name: replacement.name, manually_selected: true }).eq('id', row.id);
								if (error) throw error;
								row.planning_center_person_id = replacement.id; row.person_name = replacement.name;
								assignment.personId = replacement.id; assignment.personName = replacement.name; assignment.tier = replacement.skill_level!;
								assignment.reasons = [`Manually selected for ${assignment.positionName}`, `Assigned to ${assignment.positionName} in Planning Center`, 'No Planning Center blockout on this date'];
								pendingDraftChanges.delete(row.id);
							}
							for (const { assignment, replacement } of existingChanges) {
								const serviceTypeId = teamServiceTypes.get(week.teamId); if (!serviceTypeId) throw new Error('A Planning Center service type is missing. Generate the schedule again.');
								const teamPath = `/services/v2/service_types/${serviceTypeId}/plans/${week.planId}/team_members`;
								const current = await fetchAll<Resource>(`${teamPath}?where[team_id]=${encodeURIComponent(week.teamId)}&per_page=100`);
								let replacementPlanPerson = current.find((item) => item.relationships?.person?.data?.id === replacement.id && item.relationships?.team?.data?.id === week.teamId && item.attributes.team_position_name === assignment.positionName);
								if (!replacementPlanPerson) { const response = await callPco(teamPath, 'POST', { data: { type: 'PlanPerson', attributes: { person_id: replacement.id, team_id: week.teamId, team_position_name: assignment.positionName, status: 'Unconfirmed', prepare_notification: true } } }); replacementPlanPerson = response.data; }
								if (!assignment.derivedRole) await callPco(`/services/v2/people/${encodeURIComponent(assignment.personId)}/plan_people/${encodeURIComponent(assignment.planPersonId)}`, 'DELETE');
								pendingExistingChanges.delete(existingChangeKey(assignment)); assignment.personId = replacement.id; assignment.personName = replacement.name; assignment.planPersonId = replacementPlanPerson?.id ?? assignment.planPersonId; assignment.status = 'Unconfirmed'; assignment.derivedRole = false;
							}
							message.textContent = `${changeCount} lineup change${changeCount === 1 ? '' : 's'} committed. ${existingChanges.length ? `${existingChanges.length} replacement placeholder${existingChanges.length === 1 ? ' was' : 's were'} added privately in Planning Center with notifications prepared but not sent.` : 'Draft suggestions were saved locally.'}`;
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not save the pending schedule changes.'; }
						finally { generateButton.disabled = false; renderSchedule(); }
					};
					const renderSchedule = () => {
						results.replaceChildren();
						for (const week of renderedWeeks) {
							const card = document.createElement('article'); card.className = 'week-card';
							const heading = document.createElement('div'); heading.className = 'week-heading';
							const title = document.createElement('div'); title.innerHTML = `<p>${new Date(`${week.date}T12:00:00`).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })}</p><h2>${week.teamName}</h2>`;
							const headingActions = document.createElement('div'); headingActions.className = 'week-heading-actions'; const plan = document.createElement(week.planUrl ? 'a' : 'span'); plan.textContent = week.planId ? 'Planning Center plan found' : 'No matching plan'; if (week.planUrl) { (plan as HTMLAnchorElement).href = week.planUrl; (plan as HTMLAnchorElement).target = '_blank'; }
							const weekRows = draftRows.filter((row) => row.planning_center_plan_id === week.planId && row.planning_center_team_id === week.teamId); const pendingWeekRows = weekRows.filter((row) => !row.published_at); const stagedWeekCount = [...pendingDraftChanges.values()].filter(({ row }) => row.planning_center_plan_id === week.planId && row.planning_center_team_id === week.teamId).length + [...pendingExistingChanges.values()].filter(({ assignment }) => week.existing.includes(assignment)).length; headingActions.append(plan); if (stagedWeekCount) { const saveWeek = document.createElement('button'); saveWeek.type = 'button'; saveWeek.className = 'save-week-button'; saveWeek.textContent = `Save changes +${stagedWeekCount}`; saveWeek.setAttribute('aria-label', `Save ${stagedWeekCount} pending schedule change${stagedWeekCount === 1 ? '' : 's'}`); saveWeek.addEventListener('click', () => saveWeekChanges(week, saveWeek)); headingActions.append(saveWeek); } if (pendingWeekRows.length) { const publishWeek = document.createElement('button'); publishWeek.type = 'button'; publishWeek.className = 'publish-week-button'; publishWeek.textContent = `Add ${pendingWeekRows.length} placeholder${pendingWeekRows.length === 1 ? '' : 's'}`; publishWeek.disabled = stagedWeekCount > 0; if (stagedWeekCount) publishWeek.title = 'Save the pending lineup changes before adding placeholders to Planning Center.'; publishWeek.addEventListener('click', () => publishRows(weekRows, publishWeek)); headingActions.append(publishWeek); }
							heading.append(title, headingActions); card.append(heading);
							if (week.audioVisual.length) { const av = document.createElement('aside'); av.className = 'audio-visual-roster'; const label = document.createElement('strong'); label.textContent = 'Audio/Visual'; const names = document.createElement('span'); names.textContent = week.audioVisual.map((assignment) => `${assignment.personName} — ${assignment.positionName}`).join(' · '); av.append(label, names); card.append(av); }
							const list = document.createElement('ul'); list.className = 'assignment-list';
