								await Promise.all([...priorPlans.map((plan) => ({ plan, serviceTypeId, teams: sameServiceBandTeams })), ...legacyServiceTypeIds.flatMap((legacyServiceTypeId) => (legacyPlansByServiceType.get(legacyServiceTypeId) ?? []).filter((plan) => { const date = String(plan.attributes.sort_date ?? '').slice(0, 10); return date >= lookbackStart && date < firstDate; }).map((plan) => ({ plan, serviceTypeId: legacyServiceTypeId, teams: mergedBandTeams.filter((team) => team.relationships?.service_type?.data?.id === legacyServiceTypeId) })))].map(async ({ plan, serviceTypeId: historyServiceTypeId, teams }) => { const date = String(plan.attributes.sort_date ?? '').slice(0, 10); const members = (await Promise.all(teams.map((team) => fetchAll<Resource>(`/services/v2/service_types/${historyServiceTypeId}/plans/${plan.id}/team_members?where[team_id]=${encodeURIComponent(team.id)}&per_page=100`)))).flat(); const seen = new Set<string>(); for (const member of members.filter((item) => !['d', 'declined'].includes(String(item.attributes.status ?? '').toLowerCase()))) { const personId = member.relationships?.person?.data?.id; if (!personId || seen.has(personId)) continue; seen.add(personId); priorHistory.set(personId, [...(priorHistory.get(personId) ?? []), date]); } }));
								priorHistoryByTeam.set(teamId, priorHistory);
								for (const [personId, assignedDates] of priorHistory) schedulingHistory.set(personId, [...new Set([...(schedulingHistory.get(personId) ?? []), ...assignedDates])].sort());
								const existingForScheduler = new Map([...existingByDate].map(([date, members]) => [date, [...members.map((member) => ({ personId: member.personId, tier: settings.get(member.personId)?.skill_level ?? null, positionId: member.positionId, countsTowardHistory: member.status !== 'Declined' })), ...(audioVisualByDate.get(date) ?? []).map((member) => ({ personId: member.personId, tier: settings.get(member.personId)?.skill_level ?? null, countsTowardHistory: false }))]]));
								const suggestions = suggestWeeks(dates, slotsByDate, availability, pairs, existingForScheduler, schedulingHistory);
								for (const week of suggestions) { const plan = selectedPlansByDate.get(week.date); const rendered = { ...week, teamId, teamName: teamNames.get(teamId) ?? `Team ${teamId}`, planId: plan?.id, planUrl: plan?.attributes.planning_center_url, existing: existingByDate.get(week.date) ?? [], audioVisual: audioVisualByDate.get(week.date) ?? [] }; renderedWeeks.push(rendered); for (const personId of new Set([...rendered.existing.map((member) => member.personId), ...rendered.assignments.map((member) => member.personId)])) schedulingHistory.set(personId, [...new Set([...(schedulingHistory.get(personId) ?? []), week.date])].sort()); }
							}
							renderedWeeks.sort((a, b) => a.date.localeCompare(b.date));
							const { data: draft, error: draftError } = await supabase.from('schedule_drafts').insert({ owner_id: session.user.id, name: `Band suggestions ${startsOn.value}–${endsOn.value}`, starts_on: startsOn.value, ends_on: endsOn.value }).select('id').single();
							if (draftError) throw draftError; draftId = draft.id;
							const rows = renderedWeeks.flatMap((week) => week.planId ? week.assignments.map((assignment) => ({ owner_id: session.user.id, draft_id: draftId, planning_center_plan_id: week.planId!, planning_center_person_id: assignment.personId, planning_center_team_id: week.teamId, position_name: assignment.positionName, person_name: assignment.personName })) : []);
							if (rows.length) { const { data, error } = await supabase.from('draft_assignments').insert(rows).select('id,planning_center_plan_id,planning_center_person_id,planning_center_team_id,position_name,person_name,planning_center_plan_person_id,published_at'); if (error) throw error; draftRows = data as DraftRow[]; } else draftRows = [];
							renderSchedule(); const unfilled = renderedWeeks.reduce((sum, week) => sum + week.unfilled.length, 0); const missingPlans = renderedWeeks.filter((week) => !week.planId).length;
							const existingCount = renderedWeeks.reduce((sum, week) => sum + week.existing.length, 0);
							message.textContent = `${existingCount} existing Planning Center assignment${existingCount === 1 ? '' : 's'} found. ${draftRows.length} placeholder${draftRows.length === 1 ? '' : 's'} suggested to fill the remaining gaps across ${renderedWeeks.length} weekly band${renderedWeeks.length === 1 ? '' : 's'}.${unfilled ? ` ${unfilled} position${unfilled === 1 ? '' : 's'} could not be filled.` : ''}${missingPlans ? ` ${missingPlans} week${missingPlans === 1 ? '' : 's'} has no matching Planning Center plan.` : ''}`;
						} catch (error) { message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not generate suggestions.'; }
						finally { generateButton.disabled = false; }
					});

					publishButton.addEventListener('click', () => publishRows(draftRows, publishButton));
				}
			}
		</script>
	</body>
</html>
