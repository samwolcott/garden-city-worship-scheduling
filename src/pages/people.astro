---
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>People | Garden City Worship Scheduler</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={`${base}/`}><img src="https://static1.squarespace.com/static/620f0941d330e41f0b6d693f/t/6254fe163007293d1ab2d660/1649737238964/GC+PEDALS+ICON+%28BLACK%29.png?format=300w" alt="" /><span class="brand-copy"><strong>Garden City Church</strong><small>Worship Scheduler</small></span></a>
			<nav><a aria-current="page" href={`${base}/people/`}>People</a><a href={`${base}/bands/`}>Weekly bands</a><a href={`${base}/schedule/`}>Schedule</a></nav>
		</header>
		<main class="people-page">
			<section class="page-heading">
				<div><p class="eyebrow">Private roster</p><h1>Musicians</h1><p class="lede">Only active musicians with an assigned band tier can be considered by the scheduler.</p></div>
				<div class="summary"><strong id="active-count">0</strong><span>active</span></div>
			</section>

			<section class="toolbar" aria-label="Roster controls">
				<label>Planning Center team<select id="team-select" disabled><option>Loading teams…</option></select></label>
				<label>Search<input id="people-search" type="search" placeholder="Find a musician" /></label>
				<label class="check-label"><input id="show-inactive" type="checkbox" checked /> Show inactive</label>
			</section>
			<details id="team-visibility" class="team-visibility" hidden>
				<summary>Manage teams shown in the scheduler</summary>
				<p>Planning Center reports all of these teams as active. Hide legacy teams here; this setting is shared across authorized users.</p>
				<div id="team-visibility-list" class="team-visibility-list"></div>
			</details>

			<p id="people-message" class="notice" role="status">Connecting to Planning Center…</p>
			<div class="table-wrap" hidden>
				<table>
					<thead><tr><th id="musician-heading" aria-sort="ascending"><button class="sort-button" id="sort-musician" type="button">Musician <span aria-hidden="true">↑</span></button></th><th id="instrument-heading" aria-sort="none"><button class="sort-button" id="sort-instrument" type="button">Instrument <span aria-hidden="true">↕</span></button></th><th>Status</th><th>Band tier</th><th>Serving frequency</th><th>Save state</th></tr></thead>
					<tbody id="people-list"></tbody>
				</table>
			</div>

			<section id="pairing-panel" class="pairing-panel" hidden aria-labelledby="pairing-title">
				<div><p class="step">Hard scheduling rules</p><h2 id="pairing-title">Required pairs</h2><p>If either musician is scheduled, the other must appear on the same plan. If one is unavailable, neither will be scheduled.</p></div>
				<form id="pair-form" class="pair-form">
					<label>First musician<select id="pair-one" required></select></label>
					<span>with</span>
					<label>Second musician<select id="pair-two" required></select></label>
					<button type="submit">Require together</button>
				</form>
				<p id="pair-message" class="form-message" role="status"></p>
				<ul id="pair-list" class="pair-list"></ul>
			</section>
		</main>

		<script>
			import { getSupabase, supabaseConfigured } from '../lib/supabase';
			type PcoPerson = { id: string; attributes: { name?: string; first_name?: string; last_name?: string } };
			type PcoTeam = { id: string; attributes: { name?: string; archived_at?: string | null; deleted_at?: string | null }; relationships?: { service_type?: { data?: { id?: string } } } };
			type PcoServiceType = { id: string; attributes: { name?: string; archived_at?: string | null; deleted_at?: string | null } };
			type PcoPosition = { id: string; attributes: { name?: string } };
			type PcoPositionAssignment = { id: string; relationships?: { person?: { data?: { id?: string } }; team_position?: { data?: { id?: string } } } };
			type Setting = { owner_id: string; planning_center_person_id: string; active: boolean; skill_level: 'A' | 'B' | 'C' | null; minimum_weeks_between: number };
			type PairRule = { id: string; owner_id: string; person_one_id: string; person_two_id: string };
			type TeamSetting = { owner_id: string; planning_center_team_id: string; visible: boolean };

			const message = document.querySelector<HTMLParagraphElement>('#people-message')!;
			const table = document.querySelector<HTMLDivElement>('.table-wrap')!;
			const tbody = document.querySelector<HTMLTableSectionElement>('#people-list')!;
			const teamSelect = document.querySelector<HTMLSelectElement>('#team-select')!;
			const search = document.querySelector<HTMLInputElement>('#people-search')!;
			const showInactive = document.querySelector<HTMLInputElement>('#show-inactive')!;
			const activeCount = document.querySelector<HTMLElement>('#active-count')!;
			const pairingPanel = document.querySelector<HTMLElement>('#pairing-panel')!;
			const pairForm = document.querySelector<HTMLFormElement>('#pair-form')!;
			const pairOne = document.querySelector<HTMLSelectElement>('#pair-one')!;
			const pairTwo = document.querySelector<HTMLSelectElement>('#pair-two')!;
			const pairList = document.querySelector<HTMLUListElement>('#pair-list')!;
			const pairMessage = document.querySelector<HTMLParagraphElement>('#pair-message')!;
			const teamVisibilityPanel = document.querySelector<HTMLDetailsElement>('#team-visibility')!;
			const teamVisibilityList = document.querySelector<HTMLDivElement>('#team-visibility-list')!;
			const sortMusician = document.querySelector<HTMLButtonElement>('#sort-musician')!;
			const sortInstrument = document.querySelector<HTMLButtonElement>('#sort-instrument')!;
			const musicianHeading = document.querySelector<HTMLTableCellElement>('#musician-heading')!;
			const instrumentHeading = document.querySelector<HTMLTableCellElement>('#instrument-heading')!;
			let people: PcoPerson[] = [];
			let settings = new Map<string, Setting>();
			let pairRules: PairRule[] = [];
			let instrumentsByPerson = new Map<string, string[]>();
			let assignmentsByPerson = new Map<string, PcoPositionAssignment[]>();
			let teamPositions: PcoPosition[] = [];
			let availableTeams: PcoTeam[] = [];
			let teamSettings = new Map<string, TeamSetting>();
			let sortColumn: 'musician' | 'instrument' = 'musician';
			let sortDirection: 'ascending' | 'descending' = 'ascending';

			if (!supabaseConfigured) {
				message.textContent = 'Supabase is not configured yet.';
			} else {
				const supabase = getSupabase();
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) {
					message.textContent = 'Sign in from the home page to manage musicians.';
				} else {
					const callPco = async (path: string, method = 'GET', body?: Record<string, unknown>) => {
						const { data, error } = await supabase.functions.invoke('planning-center', { body: { method, path, body } });
						if (error) {
							const response = 'context' in error && error.context instanceof Response ? error.context : undefined;
							let detail = error.message;
							if (response) {
								try {
									const payload = await response.clone().json();
									detail = payload.error ?? payload.message ?? payload.errors?.[0]?.detail ?? detail;
								} catch {
									const body = await response.clone().text();
									if (body) detail = body;
								}
								throw new Error(`Planning Center request failed (${response.status}): ${detail}`);
							}
							throw new Error(`Could not reach the scheduling service: ${detail}`);
						}
						return data;
					};
					const fetchAll = async <T,>(path: string): Promise<T[]> => {
						const records: T[] = [];
						for (let page = 0; path && page < 20; page++) {
							const result = await callPco(path);
							records.push(...(result.data ?? []));
							path = result.links?.next ? new URL(result.links.next).pathname + new URL(result.links.next).search : '';
						}
						return records;
					};
					const populateTeamSelect = () => {
						const selected = teamSelect.value; teamSelect.replaceChildren(new Option('Choose a team', ''));
						for (const team of availableTeams.filter((item) => teamSettings.get(item.id)?.visible !== false)) teamSelect.add(new Option(team.attributes.name ?? `Team ${team.id}`, team.id));
						teamSelect.disabled = teamSelect.options.length === 1; if ([...teamSelect.options].some((option) => option.value === selected)) teamSelect.value = selected;
					};
					const renderTeamVisibility = () => {
						teamVisibilityList.replaceChildren();
						for (const team of availableTeams) {
							const saved = teamSettings.get(team.id) ?? { owner_id: session.user.id, planning_center_team_id: team.id, visible: true };
							const label = document.createElement('label'); const toggle = document.createElement('input'); toggle.type = 'checkbox'; toggle.checked = saved.visible;
							toggle.addEventListener('change', async () => { toggle.disabled = true; const next = { ...saved, visible: toggle.checked, updated_at: new Date().toISOString() }; const { error } = await supabase.from('team_settings').upsert(next, { onConflict: 'owner_id,planning_center_team_id' }); if (error) { toggle.checked = saved.visible; message.textContent = error.message; } else { teamSettings.set(team.id, next); populateTeamSelect(); } toggle.disabled = false; });
							label.append(toggle, document.createTextNode(team.attributes.name ?? `Team ${team.id}`)); teamVisibilityList.append(label);
						}
						teamVisibilityPanel.hidden = false;
					};

					const render = () => {
						const query = search.value.toLowerCase();
						tbody.replaceChildren();
						activeCount.textContent = String([...settings.values()].filter((item) => item.active).length);
						const sortedPeople = [...people].sort((a, b) => {
							const nameA = a.attributes.name ?? `${a.attributes.first_name ?? ''} ${a.attributes.last_name ?? ''}`.trim(); const nameB = b.attributes.name ?? `${b.attributes.first_name ?? ''} ${b.attributes.last_name ?? ''}`.trim();
							const valueA = sortColumn === 'musician' ? nameA : instrumentsByPerson.get(a.id)?.join(', ') ?? 'Not assigned'; const valueB = sortColumn === 'musician' ? nameB : instrumentsByPerson.get(b.id)?.join(', ') ?? 'Not assigned';
							const comparison = valueA.localeCompare(valueB, undefined, { sensitivity: 'base', numeric: true }); return sortDirection === 'ascending' ? comparison : -comparison;
						});
						for (const person of sortedPeople) {
							const name = person.attributes.name ?? `${person.attributes.first_name ?? ''} ${person.attributes.last_name ?? ''}`.trim();
							const saved = settings.get(person.id) ?? { owner_id: session.user.id, planning_center_person_id: person.id, active: false, skill_level: null, minimum_weeks_between: 2 };
							if (!name.toLowerCase().includes(query) || (!showInactive.checked && !saved.active)) continue;
							const row = document.createElement('tr');
							const nameCell = document.createElement('td'); nameCell.textContent = name;
							const instrumentCell = document.createElement('td');
							const instrumentEditor = document.createElement('details'); instrumentEditor.className = 'instrument-editor'; const instrumentSummary = document.createElement('summary'); instrumentSummary.textContent = instrumentsByPerson.get(person.id)?.join(', ') || 'Not assigned';
							const instrumentOptions = document.createElement('div'); instrumentOptions.className = 'instrument-options'; const assignedPositionIds = new Set((assignmentsByPerson.get(person.id) ?? []).map((assignment) => assignment.relationships?.team_position?.data?.id));
							for (const position of teamPositions) { const label = document.createElement('label'); const checkbox = document.createElement('input'); checkbox.type = 'checkbox'; checkbox.value = position.id; checkbox.checked = assignedPositionIds.has(position.id); label.append(checkbox, document.createTextNode(position.attributes.name ?? `Position ${position.id}`)); instrumentOptions.append(label); }
							const saveInstruments = document.createElement('button'); saveInstruments.type = 'button'; saveInstruments.textContent = 'Save instruments';
							saveInstruments.addEventListener('click', async () => {
								const selected = new Set([...instrumentOptions.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value)); const current = assignmentsByPerson.get(person.id) ?? [];
								const removals = current.filter((assignment) => { const id = assignment.relationships?.team_position?.data?.id; return id && !selected.has(id); }); const additions = teamPositions.filter((position) => selected.has(position.id) && !assignedPositionIds.has(position.id));
								if (!removals.length && !additions.length) { instrumentEditor.open = false; return; }
								if (!window.confirm(`Update ${name}'s Planning Center instruments? This will add ${additions.length} and remove ${removals.length} team position assignment${removals.length === 1 ? '' : 's'}.`)) return;
								saveInstruments.disabled = true; saveInstruments.textContent = 'Saving…';
								try {
									const serviceTypeId = availableTeams.find((team) => team.id === teamSelect.value)?.relationships?.service_type?.data?.id; if (!serviceTypeId) throw new Error('Could not identify this team’s service type.');
									for (const assignment of removals) await callPco(`/services/v2/people/${encodeURIComponent(person.id)}/person_team_position_assignments/${encodeURIComponent(assignment.id)}`, 'DELETE');
									for (const position of additions) await callPco(`/services/v2/service_types/${encodeURIComponent(serviceTypeId)}/team_positions/${encodeURIComponent(position.id)}/person_team_position_assignments`, 'POST', { data: { type: 'PersonTeamPositionAssignment', attributes: { person_id: person.id } } });
									const refreshed = await fetchAll<PcoPositionAssignment>(`/services/v2/teams/${encodeURIComponent(teamSelect.value)}/person_team_position_assignments?per_page=100`); assignmentsByPerson = new Map(); instrumentsByPerson = new Map(); const positionNames = new Map(teamPositions.map((position) => [position.id, position.attributes.name ?? `Position ${position.id}`]));
									for (const assignment of refreshed) { const personId = assignment.relationships?.person?.data?.id; const positionId = assignment.relationships?.team_position?.data?.id; if (!personId || !positionId) continue; assignmentsByPerson.set(personId, [...(assignmentsByPerson.get(personId) ?? []), assignment]); const positionName = positionNames.get(positionId); if (positionName) instrumentsByPerson.set(personId, [...(instrumentsByPerson.get(personId) ?? []), positionName]); }
									render(); message.textContent = `${name}'s instruments were updated in Planning Center.`;
								} catch (error) { saveInstruments.disabled = false; saveInstruments.textContent = 'Save instruments'; message.classList.add('error-notice'); message.textContent = error instanceof Error ? error.message : 'Could not update instruments.'; }
							});
							instrumentOptions.append(saveInstruments); instrumentEditor.append(instrumentSummary, instrumentOptions); instrumentCell.append(instrumentEditor);
							const statusCell = document.createElement('td');
							let isActive = saved.active; const statusButton = document.createElement('button'); statusButton.type = 'button'; statusButton.className = `status-toggle ${isActive ? 'is-active' : 'is-inactive'}`; const updateStatusButton = () => { statusButton.textContent = isActive ? 'Active' : 'Inactive'; statusButton.className = `status-toggle ${isActive ? 'is-active' : 'is-inactive'}`; statusButton.setAttribute('aria-pressed', String(isActive)); statusButton.setAttribute('aria-label', `${name} is ${isActive ? 'active' : 'inactive'}. Click to change.`); }; updateStatusButton(); statusCell.append(statusButton);
							const tierCell = document.createElement('td');
							const tier = document.createElement('select'); tier.setAttribute('aria-label', `Band tier for ${name}`);
							for (const [value, label] of [['', 'Not assigned'], ['A', 'A'], ['B', 'B'], ['C', 'C']]) tier.add(new Option(label, value, false, value === (saved.skill_level ?? '')));
							tierCell.append(tier);
							const frequencyCell = document.createElement('td'); const frequency = document.createElement('select'); frequency.setAttribute('aria-label', `Serving frequency for ${name}`); for (const [weeks, label] of [[1, 'Every week'], [2, 'Every 2 weeks'], [3, 'Every 3 weeks'], [4, 'Every 4 weeks'], [5, 'Every 5 weeks'], [6, 'Every 6 weeks'], [8, 'Every 8 weeks'], [13, 'Quarterly']]) frequency.add(new Option(String(label), String(weeks), false, Number(weeks) === saved.minimum_weeks_between)); frequencyCell.append(frequency);
							const stateCell = document.createElement('td'); stateCell.className = 'save-state'; stateCell.textContent = saved.active ? (saved.skill_level ? 'Eligible' : 'Needs band tier') : 'Excluded';
							const save = async () => {
								stateCell.textContent = 'Saving…';
								const next: Setting = { owner_id: saved.owner_id, planning_center_person_id: person.id, active: isActive, skill_level: (tier.value || null) as Setting['skill_level'], minimum_weeks_between: Number(frequency.value) || 2 };
								const { error } = await supabase.from('member_settings').upsert(next, { onConflict: 'owner_id,planning_center_person_id' });
								if (error) { stateCell.textContent = error.message; return false; }
								settings.set(person.id, next); stateCell.textContent = next.active ? (next.skill_level ? 'Eligible' : 'Needs band tier') : 'Excluded'; render(); return true;
							};
							statusButton.addEventListener('click', async () => { const previous = isActive; isActive = !isActive; updateStatusButton(); statusButton.disabled = true; if (!(await save())) { isActive = previous; updateStatusButton(); statusButton.disabled = false; } }); tier.addEventListener('change', save); frequency.addEventListener('change', save);
							row.append(nameCell, instrumentCell, statusCell, tierCell, frequencyCell, stateCell); tbody.append(row);
						}
					};
					const setSort = (column: 'musician' | 'instrument') => {
						if (sortColumn === column) sortDirection = sortDirection === 'ascending' ? 'descending' : 'ascending'; else { sortColumn = column; sortDirection = 'ascending'; }
						musicianHeading.setAttribute('aria-sort', sortColumn === 'musician' ? sortDirection : 'none'); instrumentHeading.setAttribute('aria-sort', sortColumn === 'instrument' ? sortDirection : 'none');
						sortMusician.querySelector('span')!.textContent = sortColumn === 'musician' ? (sortDirection === 'ascending' ? '↑' : '↓') : '↕'; sortInstrument.querySelector('span')!.textContent = sortColumn === 'instrument' ? (sortDirection === 'ascending' ? '↑' : '↓') : '↕'; render();
					};
					sortMusician.addEventListener('click', () => setSort('musician')); sortInstrument.addEventListener('click', () => setSort('instrument'));
					const personName = (id: string) => {
						const person = people.find((item) => item.id === id);
						return person?.attributes.name ?? (person ? `${person.attributes.first_name ?? ''} ${person.attributes.last_name ?? ''}`.trim() : `Planning Center person ${id}`);
					};
					const renderPairs = () => {
						pairList.replaceChildren();
						for (const pair of pairRules) {
							const item = document.createElement('li');
							const names = document.createElement('span'); names.textContent = `${personName(pair.person_one_id)} + ${personName(pair.person_two_id)}`;
							const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'text-button'; remove.textContent = 'Remove';
							remove.addEventListener('click', async () => {
								remove.disabled = true;
								const { error } = await supabase.from('required_pair_rules').delete().eq('id', pair.id);
								if (error) { pairMessage.textContent = error.message; remove.disabled = false; return; }
								pairRules = pairRules.filter((item) => item.id !== pair.id); renderPairs();
							});
							item.append(names, remove); pairList.append(item);
						}
						if (!pairRules.length) { const empty = document.createElement('li'); empty.className = 'empty-pair'; empty.textContent = 'No required pairs yet.'; pairList.append(empty); }
					};
					const configurePairSelectors = () => {
						const options = people.map((person) => new Option(personName(person.id), person.id));
						pairOne.replaceChildren(new Option('Choose a musician', ''), ...options.map((option) => option.cloneNode(true) as HTMLOptionElement));
						pairTwo.replaceChildren(new Option('Choose a musician', ''), ...options.map((option) => option.cloneNode(true) as HTMLOptionElement));
					};
					pairForm.addEventListener('submit', async (event) => {
						event.preventDefault();
						if (!pairOne.value || !pairTwo.value || pairOne.value === pairTwo.value) { pairMessage.textContent = 'Choose two different musicians.'; return; }
						const [person_one_id, person_two_id] = [pairOne.value, pairTwo.value].sort();
						pairMessage.textContent = 'Saving…';
						const owner_id = pairRules.find((item) => item.person_one_id === person_one_id && item.person_two_id === person_two_id)?.owner_id ?? session.user.id;
						const { data, error } = await supabase.from('required_pair_rules').upsert({ owner_id, person_one_id, person_two_id }, { onConflict: 'owner_id,person_one_id,person_two_id' }).select('id,owner_id,person_one_id,person_two_id').single();
						if (error) { pairMessage.textContent = error.message; return; }
						pairRules = [...pairRules.filter((item) => item.id !== data.id), data as PairRule]; pairMessage.textContent = 'Pairing rule saved.'; pairForm.reset(); renderPairs();
					});

					try {
						const serviceTypes = (await fetchAll<PcoServiceType>('/services/v2/service_types?per_page=100')).filter((serviceType) => !serviceType.attributes.archived_at && !serviceType.attributes.deleted_at);
						const nestedTeams = await Promise.all(serviceTypes.map((serviceType) => fetchAll<PcoTeam>(`/services/v2/service_types/${encodeURIComponent(serviceType.id)}/teams?per_page=100`)));
						availableTeams = [...new Map(nestedTeams.flat().filter((team) => !team.attributes.archived_at && !team.attributes.deleted_at).map((team) => [team.id, team])).values()];
						const savedTeamSettings = await supabase.from('team_settings').select('owner_id,planning_center_team_id,visible'); if (savedTeamSettings.error) throw savedTeamSettings.error;
						teamSettings = new Map((savedTeamSettings.data ?? []).map((item) => [item.planning_center_team_id, item as TeamSetting])); populateTeamSelect(); renderTeamVisibility();
						if (!availableTeams.length) {
							message.classList.add('error-notice');
							message.textContent = 'Planning Center connected, but this account can see 0 Services teams. Confirm that these are Personal Access Token credentials for a Planning Center user with access to Services and its teams.';
						} else {
							const visibleCount = availableTeams.filter((team) => teamSettings.get(team.id)?.visible !== false).length; message.textContent = `${visibleCount} of ${availableTeams.length} Planning Center teams shown. Choose one to load its musicians.`;
						}
						teamSelect.addEventListener('change', async () => {
							if (!teamSelect.value) return;
							message.textContent = 'Loading musicians…'; table.hidden = true;
							const [loadedPeople, positions, assignments, saved, savedPairs] = await Promise.all([
								fetchAll<PcoPerson>(`/services/v2/teams/${encodeURIComponent(teamSelect.value)}/people?per_page=100`),
								fetchAll<PcoPosition>(`/services/v2/teams/${encodeURIComponent(teamSelect.value)}/team_positions?per_page=100`),
								fetchAll<PcoPositionAssignment>(`/services/v2/teams/${encodeURIComponent(teamSelect.value)}/person_team_position_assignments?per_page=100`),
								supabase.from('member_settings').select('owner_id,planning_center_person_id,active,skill_level,minimum_weeks_between'),
								supabase.from('required_pair_rules').select('id,owner_id,person_one_id,person_two_id').order('created_at'),
							]);
							if (saved.error) throw saved.error;
							if (savedPairs.error) throw savedPairs.error;
							people = loadedPeople; teamPositions = positions; settings = new Map((saved.data ?? []).map((item) => [item.planning_center_person_id, item as Setting]));
							const positionNames = new Map(positions.map((position) => [position.id, position.attributes.name ?? `Position ${position.id}`]));
							instrumentsByPerson = new Map();
							assignmentsByPerson = new Map();
							for (const assignment of assignments) {
								const personId = assignment.relationships?.person?.data?.id;
								const positionId = assignment.relationships?.team_position?.data?.id;
								if (!personId || !positionId) continue;
								assignmentsByPerson.set(personId, [...(assignmentsByPerson.get(personId) ?? []), assignment]);
								const names = instrumentsByPerson.get(personId) ?? [];
								const positionName = positionNames.get(positionId);
								if (positionName && !names.includes(positionName)) names.push(positionName);
								instrumentsByPerson.set(personId, names);
							}
							pairRules = (savedPairs.data ?? []) as PairRule[];
							message.textContent = `${people.length} musicians loaded. New musicians start inactive.`; table.hidden = false; pairingPanel.hidden = false; configurePairSelectors(); renderPairs(); render();
						});
						search.addEventListener('input', render); showInactive.addEventListener('change', render);
					} catch (error) {
						message.classList.add('error-notice');
						message.textContent = error instanceof Error ? error.message : 'Could not load Planning Center.';
					}
				}
			}
		</script>
	</body>
</html>
