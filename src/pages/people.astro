---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<title>People | Garden City Worship Scheduler</title>
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href={import.meta.env.BASE_URL}>Garden City <span>Worship Scheduler</span></a>
			<nav><a aria-current="page" href={`${import.meta.env.BASE_URL}people/`}>People</a></nav>
		</header>
		<main class="people-page">
			<section class="page-heading">
				<div><p class="eyebrow">Private roster</p><h1>Musicians</h1><p class="lede">Only active musicians with an assigned tier can be considered by the scheduler.</p></div>
				<div class="summary"><strong id="active-count">0</strong><span>active</span></div>
			</section>

			<section class="toolbar" aria-label="Roster controls">
				<label>Planning Center team<select id="team-select" disabled><option>Loading teams…</option></select></label>
				<label>Search<input id="people-search" type="search" placeholder="Find a musician" /></label>
				<label class="check-label"><input id="show-inactive" type="checkbox" checked /> Show inactive</label>
			</section>

			<p id="people-message" class="notice" role="status">Connecting to Planning Center…</p>
			<div class="table-wrap" hidden>
				<table>
					<thead><tr><th>Musician</th><th>Status</th><th>Private tier</th><th>Save state</th></tr></thead>
					<tbody id="people-list"></tbody>
				</table>
			</div>
		</main>

		<script>
			import { getSupabase, supabaseConfigured } from '../lib/supabase';
			type PcoPerson = { id: string; attributes: { name?: string; first_name?: string; last_name?: string } };
			type PcoTeam = { id: string; attributes: { name?: string } };
			type Setting = { planning_center_person_id: string; active: boolean; skill_level: 'A' | 'B' | 'C' | null };

			const message = document.querySelector<HTMLParagraphElement>('#people-message')!;
			const table = document.querySelector<HTMLDivElement>('.table-wrap')!;
			const tbody = document.querySelector<HTMLTableSectionElement>('#people-list')!;
			const teamSelect = document.querySelector<HTMLSelectElement>('#team-select')!;
			const search = document.querySelector<HTMLInputElement>('#people-search')!;
			const showInactive = document.querySelector<HTMLInputElement>('#show-inactive')!;
			const activeCount = document.querySelector<HTMLElement>('#active-count')!;
			let people: PcoPerson[] = [];
			let settings = new Map<string, Setting>();

			if (!supabaseConfigured) {
				message.textContent = 'Supabase is not configured yet.';
			} else {
				const supabase = getSupabase();
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) {
					message.textContent = 'Sign in from the home page to manage musicians.';
				} else {
					const callPco = async (path: string) => {
						const { data, error } = await supabase.functions.invoke('planning-center', { body: { method: 'GET', path } });
						if (error) throw error;
						return data;
					};
					const fetchAll = async <T,>(path: string): Promise<T[]> => {
						const records: T[] = [];
						for (let page = 0; path && page < 20; page++) {
							const result = await callPco(path);
							records.push(...(result.data ?? []));
							path = result.links?.next ? new URL(result.links.next).pathname + new URL(result.links.next).search : '';
						}
						return records;
					};

					const render = () => {
						const query = search.value.toLowerCase();
						tbody.replaceChildren();
						activeCount.textContent = String([...settings.values()].filter((item) => item.active).length);
						for (const person of people) {
							const name = person.attributes.name ?? `${person.attributes.first_name ?? ''} ${person.attributes.last_name ?? ''}`.trim();
							const saved = settings.get(person.id) ?? { planning_center_person_id: person.id, active: false, skill_level: null };
							if (!name.toLowerCase().includes(query) || (!showInactive.checked && !saved.active)) continue;
							const row = document.createElement('tr');
							const nameCell = document.createElement('td'); nameCell.textContent = name;
							const statusCell = document.createElement('td');
							const toggle = document.createElement('input'); toggle.type = 'checkbox'; toggle.checked = saved.active; toggle.setAttribute('aria-label', `Active: ${name}`); statusCell.append(toggle, document.createTextNode(toggle.checked ? ' Active' : ' Inactive'));
							const tierCell = document.createElement('td');
							const tier = document.createElement('select'); tier.setAttribute('aria-label', `Tier for ${name}`);
							for (const [value, label] of [['', 'Not assigned'], ['A', 'A'], ['B', 'B'], ['C', 'C']]) tier.add(new Option(label, value, false, value === (saved.skill_level ?? '')));
							tierCell.append(tier);
							const stateCell = document.createElement('td'); stateCell.className = 'save-state'; stateCell.textContent = saved.active ? 'Eligible' : 'Excluded';
							const save = async () => {
								if (toggle.checked && !tier.value) { toggle.checked = false; stateCell.textContent = 'Choose a tier before activating'; return; }
								stateCell.textContent = 'Saving…';
								const next: Setting = { planning_center_person_id: person.id, active: toggle.checked, skill_level: (tier.value || null) as Setting['skill_level'] };
								const { error } = await supabase.from('member_settings').upsert({ ...next, owner_id: session.user.id }, { onConflict: 'owner_id,planning_center_person_id' });
								if (error) { stateCell.textContent = error.message; return; }
								settings.set(person.id, next); stateCell.textContent = next.active ? 'Eligible' : 'Excluded'; render();
							};
							toggle.addEventListener('change', save); tier.addEventListener('change', save);
							row.append(nameCell, statusCell, tierCell, stateCell); tbody.append(row);
						}
					};

					try {
						const teams = await fetchAll<PcoTeam>('/services/v2/teams?per_page=100');
						teamSelect.replaceChildren(new Option('Choose a team', ''));
						for (const team of teams) teamSelect.add(new Option(team.attributes.name ?? `Team ${team.id}`, team.id));
						teamSelect.disabled = false; message.textContent = 'Choose a Planning Center team to load its musicians.';
						teamSelect.addEventListener('change', async () => {
							if (!teamSelect.value) return;
							message.textContent = 'Loading musicians…'; table.hidden = true;
							const [loadedPeople, saved] = await Promise.all([
								fetchAll<PcoPerson>(`/services/v2/teams/${encodeURIComponent(teamSelect.value)}/people?per_page=100`),
								supabase.from('member_settings').select('planning_center_person_id,active,skill_level'),
							]);
							if (saved.error) throw saved.error;
							people = loadedPeople; settings = new Map((saved.data ?? []).map((item) => [item.planning_center_person_id, item as Setting]));
							message.textContent = `${people.length} musicians loaded. New musicians start inactive.`; table.hidden = false; render();
						});
						search.addEventListener('input', render); showInactive.addEventListener('change', render);
					} catch (error) { message.textContent = error instanceof Error ? error.message : 'Could not load Planning Center.'; }
				}
			}
		</script>
	</body>
</html>
